# Environment Variables for Personal Project Tracker
# (Optional) For Multi-Device Real-Time Cloud Sync using Firebase Firestore:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# (Optional) For Multi-Device Sync Token / Room ID default
VITE_DEFAULT_SYNC_ROOM=
